<Application x:Class="MirrorShare.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- FINAL LIGHT-GLASS DESIGN TOKENS -->
        <SolidColorBrush x:Key="InkBrush" Color="#082B68"/>
        <SolidColorBrush x:Key="InkSoftBrush" Color="#294C81"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#7086AA"/>
        <SolidColorBrush x:Key="LineBrush" Color="#D8E5F6"/>
        <SolidColorBrush x:Key="LineStrongBrush" Color="#C9DDF4"/>
        <SolidColorBrush x:Key="CardBrush" Color="#FCFEFF"/>
        <SolidColorBrush x:Key="CanvasBrush" Color="#EDF5FF"/>
        <SolidColorBrush x:Key="BlueBrush" Color="#1976F3"/>
        <SolidColorBrush x:Key="CyanBrush" Color="#15BDF3"/>
        <SolidColorBrush x:Key="VioletBrush" Color="#7047F4"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#0BB76C"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#F12A4C"/>
        <SolidColorBrush x:Key="SoftBlueBrush" Color="#EAF4FF"/>
        <SolidColorBrush x:Key="SoftGreenBrush" Color="#E8FBF2"/>
        <SolidColorBrush x:Key="SoftRedBrush" Color="#FFF0F3"/>

        <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#16BDF3" Offset="0"/>
            <GradientStop Color="#1F7AF6" Offset="0.50"/>
            <GradientStop Color="#7549F5" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="PrimaryGradientHover" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#29C8F5" Offset="0"/>
            <GradientStop Color="#2E84FF" Offset="0.50"/>
            <GradientStop Color="#8259FF" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="HeroGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FEFFFF" Offset="0"/>
            <GradientStop Color="#F5FAFF" Offset="0.45"/>
            <GradientStop Color="#F2F0FF" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="HeaderGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FCFEFF" Offset="0"/>
            <GradientStop Color="#F7FBFF" Offset="0.55"/>
            <GradientStop Color="#F5F6FF" Offset="1"/>
        </LinearGradientBrush>

        <RadialGradientBrush x:Key="HeroGlowBrush" Center="0.5,0.45" GradientOrigin="0.5,0.45" RadiusX="0.7" RadiusY="0.65">
            <GradientStop Color="#8BD6FF" Offset="0"/>
            <GradientStop Color="#DDF2FF" Offset="0.45"/>
            <GradientStop Color="#00FFFFFF" Offset="1"/>
        </RadialGradientBrush>

        <DropShadowEffect x:Key="CardShadow" BlurRadius="24" ShadowDepth="5" Opacity="0.10" Color="#315F9A"/>
        <DropShadowEffect x:Key="ButtonShadow" BlurRadius="18" ShadowDepth="4" Opacity="0.20" Color="#2A62D5"/>
        <DropShadowEffect x:Key="SoftShadow" BlurRadius="15" ShadowDepth="3" Opacity="0.08" Color="#395F8C"/>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="24"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
        </Style>

        <Style x:Key="InsetCard" TargetType="Border">
            <Setter Property="Background" Value="#F9FCFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="18"/>
        </Style>

        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI Variable Text"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" CornerRadius="15"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#F1F7FF"/>
                                <Setter TargetName="B" Property="BorderBrush" Value="#BBD4F6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="B" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource PrimaryGradient}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="26,15"/>
            <Setter Property="Effect" Value="{StaticResource ButtonShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" CornerRadius="16"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{StaticResource PrimaryGradientHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="B" Property="Opacity" Value="0.84"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
            <Setter Property="Background" Value="#FFF7F9"/>
            <Setter Property="BorderBrush" Value="#FFD2DA"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="20,15"/>
        </Style>

        <Style x:Key="SegmentButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="BorderBrush" Value="#D7E3F4"/>
            <Setter Property="Background" Value="#FBFDFF"/>
        </Style>

        <Style x:Key="BadgeBorder" TargetType="Border">
            <Setter Property="Background" Value="#F8FBFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Padding" Value="12,8"/>
        </Style>

        <Style x:Key="FooterCard" TargetType="Border">
            <Setter Property="Background" Value="#FCFEFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Effect" Value="{StaticResource SoftShadow}"/>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable Text"/>
        </Style>
    </Application.Resources>
</Application>
