<Window x:Class="MirrorShare.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mirror Share Settings"
        Width="520" Height="430"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#EEF5FF">
    <Border Margin="16" Style="{StaticResource Card}" Padding="22">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="SETTINGS" Foreground="{StaticResource InkBrush}" FontSize="22" FontWeight="Bold"/>
                <TextBlock Text="Choose the source display and default streaming profile." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,5,0,0"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="0,24,0,0">
                <TextBlock Text="SOURCE DISPLAY" Foreground="{StaticResource InkBrush}" FontSize="11" FontWeight="Bold"/>
                <ComboBox x:Name="MonitorCombo" Height="42" Margin="0,8,0,0" FontSize="12" Padding="10,6"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Margin="0,20,0,0">
                <TextBlock Text="DEFAULT PROFILE" Foreground="{StaticResource InkBrush}" FontSize="11" FontWeight="Bold"/>
                <ComboBox x:Name="ProfileCombo" Height="42" Margin="0,8,0,0" FontSize="12" Padding="10,6">
                    <ComboBoxItem Content="High Quality"/>
                    <ComboBoxItem Content="Balanced"/>
                    <ComboBoxItem Content="Low Latency"/>
                </ComboBox>
            </StackPanel>

            <Border Grid.Row="3" Margin="0,20,0,0" Background="#F6FAFF" BorderBrush="#DCE7F7" BorderThickness="1" CornerRadius="14" Padding="14">
                <StackPanel>
                    <TextBlock Text="AUDIO ROUTING" Foreground="{StaticResource InkBrush}" FontSize="11" FontWeight="Bold"/>
                    <TextBlock TextWrapping="Wrap" Text="For TV-only system audio, Windows output must be routed to CABLE Input (VB-Audio Virtual Cable). The sender captures CABLE Output automatically." Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,7,0,0"/>
                    <Button Style="{StaticResource PillButton}" Content="OPEN WINDOWS SOUND SETTINGS" HorizontalAlignment="Left" Margin="0,12,0,0" Click="OpenSound_Click"/>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Style="{StaticResource PillButton}" Content="CANCEL" Click="Cancel_Click" Margin="0,0,8,0"/>
                <Button Style="{StaticResource PillButton}" Background="{StaticResource BlueBrush}" Foreground="White" BorderThickness="0" Content="SAVE" Click="Save_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
