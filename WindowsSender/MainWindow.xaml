<Window x:Class="MirrorShare.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Mirror Share – Sender"
        Icon="Assets/mirror_share.ico"
        Width="1600" Height="900"
        MinWidth="1280" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{StaticResource CanvasBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="102"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="122"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="{StaticResource HeaderGradient}" BorderBrush="#D7E5F6" BorderThickness="0,0,0,1">
            <Grid Margin="30,14,30,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0" Source="Assets/mirror_share_logo.png" Width="250" Height="68" Stretch="Uniform" VerticalAlignment="Center"/>
                <Border Grid.Column="2" Width="1" Height="48" Background="#CADCF2" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="4" VerticalAlignment="Center">
                    <TextBlock Text="Mirror Share" Foreground="{StaticResource InkBrush}" FontSize="24" FontWeight="Bold"/>
                    <TextBlock Text="Professional low-latency wireless screen casting" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="SystemReadyPill" Background="{StaticResource SoftGreenBrush}" BorderBrush="#C7F0DE" BorderThickness="1" CornerRadius="18" Padding="16,10" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="HeroDot" Width="9" Height="9" Fill="{StaticResource SuccessBrush}" Margin="0,0,9,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="SystemReadyText" Text="Ready to Cast" Foreground="#087B51" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock x:Name="HeroPillText" Text="READY" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>
                    <Button Style="{StaticResource PillButton}" Content="⚙  Settings" Click="Settings_Click" Margin="0,0,10,0"/>
                    <Button Style="{StaticResource PillButton}" Content="▤  Logs" Click="Logs_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN SINGLE PAGE -->
        <Grid Grid.Row="1" Margin="28,18,28,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="31*" MinWidth="340"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="36*" MinWidth="430"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="33*" MinWidth="365"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT RECEIVER PANEL -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <Grid Margin="18,18,18,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="48" Height="48" CornerRadius="14" Background="#EAF5FF" BorderBrush="#D2E7FF" BorderThickness="1">
                            <Canvas Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Rectangle Width="22" Height="15" RadiusX="2" RadiusY="2" Stroke="#1976F3" StrokeThickness="2" Canvas.Left="2" Canvas.Top="2"/>
                                <Line X1="13" Y1="17" X2="13" Y2="22" Stroke="#1976F3" StrokeThickness="2"/>
                                <Line X1="8" Y1="23" X2="18" Y2="23" Stroke="#1976F3" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Canvas>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,8,0" VerticalAlignment="Center">
                            <TextBlock Text="Receiver Devices" Foreground="{StaticResource InkBrush}" FontSize="18" FontWeight="Bold"/>
                            <TextBlock Text="Nearby displays on this network" Foreground="{StaticResource MutedBrush}" FontSize="10.5" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="2" x:Name="ScanButton" Style="{StaticResource PillButton}" Width="46" Height="46" Padding="0" Content="↻" FontSize="21" Click="Scan_Click"/>
                    </Grid>

                    <TextBlock Grid.Row="1" x:Name="DiscoverySummary" Text="Searching local network..." Foreground="{StaticResource SuccessBrush}" FontSize="10.5" Margin="4,16,0,8"/>

                    <Grid Grid.Row="2" ClipToBounds="True" Margin="0,0,0,10">
                        <ItemsControl x:Name="ReceiverItems">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#F4FAFF" BorderBrush="#CFE4F8" BorderThickness="1" CornerRadius="18" Margin="0,5" Padding="13,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="46"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="18"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="40" Height="40" CornerRadius="12" Background="#E6F3FF" VerticalAlignment="Center">
                                                <Canvas Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Rectangle Width="20" Height="14" RadiusX="2" RadiusY="2" Stroke="#1976F3" StrokeThickness="2" Canvas.Left="2" Canvas.Top="2"/>
                                                    <Line X1="12" Y1="16" X2="12" Y2="20" Stroke="#1976F3" StrokeThickness="2"/>
                                                    <Line X1="8" Y1="21" X2="16" Y2="21" Stroke="#1976F3" StrokeThickness="2"/>
                                                </Canvas>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,8,0">
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource InkBrush}" FontWeight="SemiBold" FontSize="13"/>
                                                <TextBlock Text="{Binding Ip}" Foreground="{StaticResource MutedBrush}" FontSize="10.5" Margin="0,4,0,0"/>
                                            </StackPanel>
                                            <Ellipse Grid.Column="2" Width="8" Height="8" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center"/>
                                            <Button Grid.Column="3" Content="Connect" Style="{StaticResource PrimaryButton}" Padding="18,10" FontSize="12" Click="SelectReceiver_Click" Effect="{x:Null}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border x:Name="NoReceiverPanel" Background="#F9FCFF" BorderBrush="#D8E6F6" BorderThickness="1" CornerRadius="18" Padding="18" VerticalAlignment="Top" Margin="0,5,0,0">
                            <StackPanel HorizontalAlignment="Center" Margin="0,16">
                                <TextBlock Text="◇" Foreground="{StaticResource VioletBrush}" FontSize="28" HorizontalAlignment="Center"/>
                                <TextBlock Text="NO RECEIVER FOUND" Foreground="{StaticResource InkBrush}" FontSize="12" FontWeight="Bold" Margin="0,7,0,0"/>
                                <TextBlock Text="Open the receiver app on your TV" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="3" Margin="0,3,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Height="1" Background="#E0E9F5" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="OR" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="12,0"/>
                        <Border Grid.Column="2" Height="1" Background="#E0E9F5" VerticalAlignment="Center"/>
                    </Grid>

                    <StackPanel Grid.Row="4">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Width="38" Height="38" CornerRadius="11" Background="#EAF5FF" Margin="0,0,10,0">
                                <Canvas Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Rectangle Width="18" Height="12" RadiusX="2" RadiusY="2" Stroke="#1976F3" StrokeThickness="2" Canvas.Left="2" Canvas.Top="2"/>
                                    <Line X1="11" Y1="14" X2="11" Y2="18" Stroke="#1976F3" StrokeThickness="2"/>
                                    <Line X1="7" Y1="19" X2="15" Y2="19" Stroke="#1976F3" StrokeThickness="2"/>
                                </Canvas>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Manual Connect" Foreground="{StaticResource InkBrush}" FontSize="14" FontWeight="Bold"/>
                                <TextBlock Text="Enter receiver IP address" Foreground="{StaticResource MutedBrush}" FontSize="9.5" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Border Background="#FFFFFF" BorderBrush="#CFE0F4" BorderThickness="1" CornerRadius="14">
                                <TextBox x:Name="ManualIpTextBox" Text="192.168.1.105" BorderThickness="0" Background="Transparent" Foreground="{StaticResource InkBrush}" FontSize="13" Padding="16,12" VerticalContentAlignment="Center"/>
                            </Border>
                            <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Padding="20,12" FontSize="13" Content="Connect" Click="ManualConnect_Click" Effect="{x:Null}"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="4,11,0,0">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock x:Name="LeftStatusText" Text="Ready for receiver selection" Foreground="{StaticResource SuccessBrush}" FontSize="10.5"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- CENTER HERO PANEL -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Background="{StaticResource HeroGradient}" ClipToBounds="True">
                <Grid>
                    <!-- subtle background glow -->
                    <Ellipse Width="560" Height="430" Fill="{StaticResource HeroGlowBrush}" Opacity="0.55" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-60,0,0"/>

                    <!-- fluid wave ribbons -->
                    <Viewbox Stretch="Fill" Opacity="0.24" HorizontalAlignment="Stretch" VerticalAlignment="Center" Height="285">
                        <Canvas Width="700" Height="260">
                            <Path Stroke="#28C5F6" StrokeThickness="30" Opacity="0.42" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M -20,155 C 95,90 150,210 270,150 C 370,100 430,60 535,125 C 610,170 660,190 730,138"/>
                            <Path Stroke="#5A77FF" StrokeThickness="18" Opacity="0.38" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M -15,170 C 95,115 170,218 286,160 C 385,110 445,88 555,144 C 625,180 680,183 730,152"/>
                            <Path Stroke="#8C55FF" StrokeThickness="10" Opacity="0.28" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M 0,185 C 100,135 185,220 300,172 C 390,135 470,110 575,160 C 640,190 690,180 715,165"/>
                        </Canvas>
                    </Viewbox>
<Grid Margin="24,20,24,20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- hidden state carrier for code-behind; UI status is in header -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Opacity="0">
                            <TextBlock x:Name="HeroPillTextShadow" Text="READY"/>
                        </StackPanel>

                        <!-- Final center watermark: light blue, crisp, and isolated from title -->
                        <Image Grid.Row="1"
                               Source="Assets/mirror_share_symbol.png"
                               Width="238"
                               Height="238"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="0,-18,0,26"
                               Opacity="0.72"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               SnapsToDevicePixels="True"
                               IsHitTestVisible="False"/>

                        <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,8,0,14">
                            <TextBlock Text="MIRROR SHARE" Foreground="{StaticResource InkBrush}" FontSize="31" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="HeroSubtitle" Text="Select a receiver and start casting your screen" Foreground="{StaticResource MutedBrush}" FontSize="13" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0" Visibility="Collapsed">
                                <TextBlock x:Name="SelectedReceiverState" Text="WAITING"/>
                                <TextBlock x:Name="SelectedReceiverName" Text="No receiver selected"/>
                                <TextBlock x:Name="SelectedReceiverIp" Text=""/>
                            </StackPanel>
                        </StackPanel>

                        <!-- badges -->
                        <UniformGrid Grid.Row="3" Columns="4" HorizontalAlignment="Center" Margin="8,0,8,14">
                            <Border Style="{StaticResource BadgeBorder}" Margin="4,0">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="28" Height="28" CornerRadius="9" Background="#E9F5FF" Margin="0,0,8,0">
                                        <TextBlock Text="▣" Foreground="{StaticResource BlueBrush}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="BadgeResolution" Text="1080P" Foreground="{StaticResource InkBrush}" FontWeight="Bold" FontSize="11"/>
                                        <TextBlock Text="Full HD" Foreground="{StaticResource MutedBrush}" FontSize="8.5"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource BadgeBorder}" Margin="4,0">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="28" Height="28" CornerRadius="9" Background="#F0EDFF" Margin="0,0,8,0">
                                        <TextBlock Text="✦" Foreground="{StaticResource VioletBrush}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="BadgeFps" Text="60 FPS" Foreground="{StaticResource InkBrush}" FontWeight="Bold" FontSize="11"/>
                                        <TextBlock Text="Smooth" Foreground="{StaticResource MutedBrush}" FontSize="8.5"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource BadgeBorder}" Margin="4,0">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="28" Height="28" CornerRadius="9" Background="#E9F5FF" Margin="0,0,8,0">
                                        <TextBlock Text="◆" Foreground="{StaticResource BlueBrush}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="H.264" Foreground="{StaticResource InkBrush}" FontWeight="Bold" FontSize="11"/>
                                        <TextBlock Text="Efficient" Foreground="{StaticResource MutedBrush}" FontSize="8.5"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource BadgeBorder}" Margin="4,0">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="28" Height="28" CornerRadius="9" Background="#F0EDFF" Margin="0,0,8,0">
                                        <TextBlock Text="ϟ" Foreground="{StaticResource VioletBrush}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Low Latency" Foreground="{StaticResource InkBrush}" FontWeight="Bold" FontSize="10"/>
                                        <TextBlock Text="Real-time" Foreground="{StaticResource MutedBrush}" FontSize="8.5"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- cast controls -->
                        <Grid Grid.Row="4" HorizontalAlignment="Center">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="310"/><ColumnDefinition Width="14"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
                            <Button x:Name="StartCastingButton" Grid.Column="0" Style="{StaticResource PrimaryButton}" Click="StartCasting_Click">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="▶" FontSize="19" Margin="0,0,13,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="START CASTING" FontSize="17" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="StopCastingButton" Grid.Column="2" Style="{StaticResource DangerButton}" Content="■  STOP" Click="StopCasting_Click"/>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <!-- RIGHT STATUS / PROFILE -->
            <Grid Grid.Column="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1.02*"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="0.98*"/>
                </Grid.RowDefinitions>

                <!-- Stream status -->
                <Border Grid.Row="0" Style="{StaticResource Card}">
                    <Grid Margin="18,18,18,18">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Border Width="48" Height="48" CornerRadius="14" Background="#EAF5FF" BorderBrush="#D4E9FF" BorderThickness="1">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Rectangle Width="4" Height="12" RadiusX="2" Fill="#1976F3" Margin="1,0" VerticalAlignment="Bottom"/>
                                    <Rectangle Width="4" Height="19" RadiusX="2" Fill="#1976F3" Margin="1,0" VerticalAlignment="Bottom"/>
                                    <Rectangle Width="4" Height="26" RadiusX="2" Fill="#1976F3" Margin="1,0" VerticalAlignment="Bottom"/>
                                </StackPanel>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Stream Status" Foreground="{StaticResource InkBrush}" FontSize="18" FontWeight="Bold"/>
                                <TextBlock Text="Current casting session information" Foreground="{StaticResource MutedBrush}" FontSize="10.5" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="RightReadyDot" Width="9" Height="9" Fill="{StaticResource SuccessBrush}" Margin="0,0,8,0"/>
                                <TextBlock x:Name="RightReadyText" Text="Ready" Foreground="{StaticResource SuccessBrush}" FontWeight="Bold" FontSize="12"/>
                            </StackPanel>
                        </Grid>

                        <UniformGrid Grid.Row="2" Columns="2" Rows="2">
                            <Border Style="{StaticResource InsetCard}" Margin="0,0,6,6" Padding="15,13">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="▣" Foreground="{StaticResource BlueBrush}" FontSize="18" FontWeight="Bold" Margin="0,0,10,0"/>
                                        <TextBlock Text="VIDEO" Foreground="{StaticResource InkBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock x:Name="VideoStatusText" Text="Not Streaming" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,12,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource InsetCard}" Margin="6,0,0,6" Padding="15,13">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="◖" Foreground="{StaticResource BlueBrush}" FontSize="21" FontWeight="Bold" Margin="0,0,10,0"/>
                                        <TextBlock Text="AUDIO" Foreground="{StaticResource InkBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock x:Name="AudioStatusText" Text="Not Streaming" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,12,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource InsetCard}" Margin="0,6,6,0" Padding="15,13">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="▱" Foreground="{StaticResource BlueBrush}" FontSize="20" FontWeight="Bold" Margin="0,0,10,0"/>
                                        <TextBlock Text="RESOLUTION" Foreground="{StaticResource InkBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock x:Name="ResolutionStatusText" Text="1920 × 1080" Foreground="{StaticResource InkSoftBrush}" FontSize="12" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource InsetCard}" Margin="6,6,0,0" Padding="15,13">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="◔" Foreground="{StaticResource BlueBrush}" FontSize="20" FontWeight="Bold" Margin="0,0,10,0"/>
                                        <TextBlock Text="FPS" Foreground="{StaticResource InkBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock x:Name="FpsStatusText" Text="60 FPS" Foreground="{StaticResource InkSoftBrush}" FontSize="12" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </Grid>
                </Border>

                <!-- Streaming profile -->
                <Border Grid.Row="2" Style="{StaticResource Card}">
                    <Grid Margin="18,16,18,16">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Width="48" Height="48" CornerRadius="14" Background="#EAF5FF" BorderBrush="#D4E9FF" BorderThickness="1">
                                <TextBlock Text="≋" Foreground="{StaticResource BlueBrush}" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Streaming Profile" Foreground="{StaticResource InkBrush}" FontSize="18" FontWeight="Bold"/>
                                <TextBlock Text="Adjust streaming quality and performance" Foreground="{StaticResource MutedBrush}" FontSize="10.5" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>

                        <UniformGrid Grid.Row="2" Columns="3">
                            <Button x:Name="HighQualityButton" Style="{StaticResource SegmentButton}" Content="HIGH QUALITY" Click="HighQuality_Click" Margin="0,0,4,0"/>
                            <Button x:Name="BalancedButton" Style="{StaticResource SegmentButton}" Content="BALANCED" Click="Balanced_Click" Margin="2,0"/>
                            <Button x:Name="LowLatencyButton" Style="{StaticResource SegmentButton}" Content="LOW LATENCY" Click="LowLatency_Click" Margin="4,0,0,0"/>
                        </UniformGrid>

                        <Border Grid.Row="4" Style="{StaticResource InsetCard}" Background="#F5F9FF" Padding="15,10">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="1"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="28" Height="28" CornerRadius="8" Background="#EAF5FF" Margin="0,0,9,0">
                                            <TextBlock Text="⚙" Foreground="{StaticResource BlueBrush}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Encoder" Foreground="{StaticResource MutedBrush}" FontSize="10.5" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock x:Name="EncoderText" Grid.Column="1" Text="Detecting..." Foreground="{StaticResource InkBrush}" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                </Grid>
                                <Border Grid.Row="1" Background="#DCE7F5" Margin="0,3"/>
                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="28" Height="28" CornerRadius="8" Background="#EAF5FF" Margin="0,0,9,0">
                                            <TextBlock Text="▥" Foreground="{StaticResource BlueBrush}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Bitrate" Foreground="{StaticResource MutedBrush}" FontSize="10.5" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock x:Name="BitrateText" Grid.Column="1" Text="18 Mbps" Foreground="{StaticResource InkBrush}" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- FOOTER -->
        <Grid Grid.Row="2" Margin="28,0,28,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource FooterCard}">
                <Grid Margin="17,13">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="48" Height="48" CornerRadius="14" Background="#EAF5FF" VerticalAlignment="Center">
                        <TextBlock Text="⌁" Foreground="{StaticResource BlueBrush}" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Network" Foreground="{StaticResource InkBrush}" FontSize="12" FontWeight="Bold"/>
                        <TextBlock x:Name="NetworkFooterText" Text="UDP 5002" Foreground="{StaticResource InkBrush}" FontSize="13" FontWeight="SemiBold" Margin="0,5,0,0"/>
                        <TextBlock Text="Automatic receiver discovery" Foreground="{StaticResource MutedBrush}" FontSize="9.5" Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource FooterCard}">
                <Grid Margin="17,13">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="48" Height="48" CornerRadius="14" Background="#EAF5FF" VerticalAlignment="Center">
                        <TextBlock Text="▣" Foreground="{StaticResource BlueBrush}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="System Encoder" Foreground="{StaticResource InkBrush}" FontSize="12" FontWeight="Bold"/>
                        <TextBlock x:Name="EncoderFooterText" Text="Detecting..." Foreground="{StaticResource InkBrush}" FontSize="13" FontWeight="SemiBold" Margin="0,5,0,0"/>
                        <TextBlock Text="Hardware acceleration" Foreground="{StaticResource MutedBrush}" FontSize="9.5" Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource FooterCard}">
                <Grid Margin="17,13">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="48" Height="48" CornerRadius="14" Background="#EAF5FF" VerticalAlignment="Center">
                        <TextBlock Text="▶" Foreground="{StaticResource BlueBrush}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Stream" Foreground="{StaticResource InkBrush}" FontSize="12" FontWeight="Bold"/>
                        <TextBlock x:Name="StreamFooterText" Text="Idle" Foreground="{StaticResource InkBrush}" FontSize="13" FontWeight="SemiBold" Margin="0,5,0,0"/>
                        <TextBlock Text="H.264 • Low latency" Foreground="{StaticResource MutedBrush}" FontSize="9.5" Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="6" Style="{StaticResource FooterCard}">
                <Grid Margin="17,13">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border Width="48" Height="48" CornerRadius="14" Background="#EAF5FF" VerticalAlignment="Center">
                        <TextBlock Text="◷" Foreground="{StaticResource BlueBrush}" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Session" Foreground="{StaticResource InkBrush}" FontSize="12" FontWeight="Bold"/>
                        <TextBlock x:Name="SessionFooterText" Text="Ready" Foreground="{StaticResource InkBrush}" FontSize="13" FontWeight="SemiBold" Margin="0,5,0,0"/>
                        <TextBlock Text="Start → Stop → Reconnect" Foreground="{StaticResource MutedBrush}" FontSize="9.5" Margin="0,3,0,0"/>
                    </StackPanel>
                    <TextBlock x:Name="SessionDurationText" Grid.Column="2" Text="00:00:00" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
